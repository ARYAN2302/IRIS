# IRIS .gitignore

# ── Model checkpoints (large, downloaded from Modal) ──
models/
*.pt
*.pth
*.onnx
*.npz
!data/manifests/*.json

# ── Data files (large, downloaded from Modal/HuggingFace) ──
data/iris_rfuav.h5
data/iris_matched_bg.h5
data/test_registry.json
data/blue_force_registry.json

# ── Sample cache ──
.iris_samples/

# ── Results (regenerated by scripts) ──
results/*.gif
# Allow PNG plots, JSON, and MD reports — they're useful for sharing
# results/*.png
# results/*.json

# Keep markdown reports (committed for reference)
!results/*.md

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual environments ──
venv/
env/
ENV/
.venv/
.env

# ── IDE ──
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ──
.DS_Store
Thumbs.db

# ── Modal ──
.modal.toml
.modal-cache/

# ── Logs ──
*.log
logs/

# ── Notebooks checkpoints ──
.ipynb_checkpoints/

# ── Coverage ──
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
